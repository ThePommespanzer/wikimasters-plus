{
  "manifest_version": 3,
  "name": "WikiMasters+",
  "version": "1.9.1",
  "description": "Extension non officielle pour WikiMasters : révélé animé, stats de tirages, tags rapides, outils de carte et cache.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://www.wiki-masters.com/*",
    "https://wiki-masters.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WikiMasters+",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.wiki-masters.com/*",
        "https://wiki-masters.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.wiki-masters.com/*",
        "https://wiki-masters.com/*"
      ],
      "js": [
        "common.js",
        "content.js",
        "panel.js",
        "stage.js",
        "settings.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.wiki-masters.com/*",
        "https://wiki-masters.com/*"
      ],
      "js": [
        "tags.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.wiki-masters.com/*",
        "https://wiki-masters.com/*"
      ],
      "js": [
        "lib/html-to-image.js",
        "cards.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "homepage_url": "https://github.com/ThePommespanzer/wikimasters-plus"
}